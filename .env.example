# FIRESTORM configuration template. Copy to .env and fill in real values.
# Every value here is a placeholder: no secrets belong in source control.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # SECRET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # INGEST_API_KEY

# --- core ------------------------------------------------------------------
FIRESTORM_APP_ENV=development            # development | test | staging | production
FIRESTORM_SECRET_KEY=replace-with-48-plus-random-bytes
FIRESTORM_DATABASE_URL=postgresql+psycopg://firestorm:CHANGE_ME@db:5432/firestorm
FIRESTORM_API_PREFIX=/api/v1
FIRESTORM_ACCESS_TOKEN_MINUTES=15
FIRESTORM_REFRESH_TOKEN_DAYS=7

# --- http / security -------------------------------------------------------
FIRESTORM_CORS_ORIGINS=https://firestorm.example.com
FIRESTORM_ALLOWED_HOSTS=firestorm.example.com
FIRESTORM_FORCE_HTTPS=true
FIRESTORM_RATE_LIMIT_PER_MINUTE=240
FIRESTORM_LOGIN_ATTEMPTS_PER_15MIN=10
FIRESTORM_INGEST_API_KEY=replace-with-random-sensor-key

# --- optional infrastructure ----------------------------------------------
# FIRESTORM_REDIS_URL=redis://redis:6379/0
# FIRESTORM_CELERY_BROKER_URL=redis://redis:6379/1
# FIRESTORM_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- bootstrap / demo ------------------------------------------------------
FIRESTORM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FIRESTORM_BOOTSTRAP_ADMIN_PASSWORD=
FIRESTORM_BOOTSTRAP_ADMIN_NAME=Firestorm Administrator
FIRESTORM_DEMO_MODE=false
FIRESTORM_DEMO_DATA=false
FIRESTORM_DEMO_TRAFFIC=false
FIRESTORM_DEMO_PASSWORD=

# --- enforcement -----------------------------------------------------------
# simulated = record intent only; live = call the configured appliances.
FIRESTORM_ENFORCEMENT_MODE=simulated
FIRESTORM_REQUIRE_APPROVAL_FOR_CONTAINMENT=true
FIRESTORM_AUTO_CONTAINMENT_THRESHOLD=85

# --- integrations (leave blank to keep adapters not_configured) -----------
FIRESTORM_FIREWALL_ENDPOINT=
FIRESTORM_FIREWALL_TOKEN=
FIRESTORM_FIREWALL_ALIAS=FIRESTORM_BLOCK
FIRESTORM_NAC_ENDPOINT=
FIRESTORM_NAC_TOKEN=
FIRESTORM_NAC_QUARANTINE_VLAN=900
FIRESTORM_EDR_ENDPOINT=
FIRESTORM_EDR_TOKEN=
FIRESTORM_IDP_ENDPOINT=
FIRESTORM_IDP_TOKEN=
FIRESTORM_SURICATA_EVE_PATH=/var/log/suricata/eve.json
FIRESTORM_ZEEK_LOG_DIR=/var/log/zeek/current
FIRESTORM_WAZUH_ENDPOINT=
FIRESTORM_WAZUH_TOKEN=
FIRESTORM_OSQUERY_ENDPOINT=
FIRESTORM_CLAMAV_HOST=
FIRESTORM_CLAMAV_PORT=3310
FIRESTORM_YARA_RULES_DIR=/etc/firestorm/yara
FIRESTORM_THREAT_FEED_URL=
FIRESTORM_THREAT_FEED_TOKEN=

# --- notifications ---------------------------------------------------------
FIRESTORM_SMTP_HOST=
FIRESTORM_SMTP_PORT=587
FIRESTORM_SMTP_USERNAME=
FIRESTORM_SMTP_PASSWORD=
FIRESTORM_SMTP_USE_TLS=true
FIRESTORM_SMTP_FROM=firestorm@example.com
FIRESTORM_SMTP_RECIPIENTS=soc@example.com

# --- observability ---------------------------------------------------------
FIRESTORM_LOG_LEVEL=INFO
FIRESTORM_LOG_JSON=true
FIRESTORM_METRICS_ENABLED=true
